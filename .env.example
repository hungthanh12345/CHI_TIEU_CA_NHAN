# Mẫu cho stack demo mới; không dùng để thay thế .env hiện có trên VM.
DB_NAME=chi_tieu
DB_USER=chi_tieu_app
DB_PASSWORD=replace-with-a-local-database-password
SESSION_SECRET=replace-with-a-random-session-secret-at-least-32-characters
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-grafana-password
PGADMIN_DEFAULT_EMAIL=nguyenthanhhung06072006@gmail.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-local-pgadmin-password
POSTGRES_EXPORTER_USER=chi_tieu_metrics
POSTGRES_EXPORTER_PASSWORD=replace-with-a-local-exporter-password
# Must match the Compose project label; set to expense-tracker-demo on that existing VM deployment.
PROMTAIL_COMPOSE_PROJECT=chi-tieu-ca-nhan
NGINX_HTTP_PORT=8080
